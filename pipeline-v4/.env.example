# ============================================================
# AIOps Pipeline v4 — LLM API 配置
# ============================================================
# 使用方式：复制本文件为 .env，然后填写你的 API Key
#   cp .env.example .env
# ============================================================

# ── 中转站（OpenAI 兼容 API，推荐）──────────────────────────
# 若填写 CHAT_API_KEY，则 Stage 1 的「Gemini 草案」与「ChatGPT 草案」、
# Stage 3「主控合成」中的 Gemini 均走同一中转地址，仅 MODEL 不同。
# 示例：ChatAnywhere — https://www.chatanywhere.tech
CHAT_API_KEY=
CHAT_BASE_URL=https://api.chatanywhere.tech/v1

# 中转站上对应的模型名（以服务商文档为准，可自行改名）
GEMINI_MODEL=gemini-3-pro-preview
OPENAI_MODEL=gpt-4o

# ── Google Gemini 直连（可选，仅在不使用 CHAT_API_KEY 时生效）──
# GEMINI_API_KEY=
# 直连时模型名一般为 google 官方 id，如 gemini-2.5-pro

# ── OpenAI / ChatGPT 直连（可选，仅在不使用 CHAT_API_KEY 时生效）──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── DeepSeek ─────────────────────────────────────────────
# API 要求 max_tokens ∈ [1, 8192]；超出会自动截断（也可用 DEEPSEEK_MAX_TOKENS_CAP 覆盖上限数字）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Kimi（月之暗面 Moonshot，OpenAI 兼容）──────────────────
# Stage 2 交叉评审。Key 在 https://platform.moonshot.cn/ 申请。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# kimi-k2.6 等模型通常仅允许 temperature=1，否则会 400；若官方变更可改此值
KIMI_TEMPERATURE=1
